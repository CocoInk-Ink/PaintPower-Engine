<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PaintPower_VM.VMPanel"
             x:Class="PaintPower_VM.VMPanel.StageAreaPart">

    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             StretchDirection="DownOnly">

        <StackPanel>
            <Grid RowDefinitions="Auto,*">
                <vm:TopBarStagePart Grid.Row="0" />
                <Grid Grid.Row="1">
                    <vm:Stage x:Name="StageControl" />
                    <vm:ProcessingPanel x:Name="LoadingPart" />
                </Grid>
            </Grid>
            <StackPanel x:Name="ExtraControls">
                <Button x:Name="ExitButton">Back</Button>
            </StackPanel>
        </StackPanel>

    </Viewbox>
</UserControl>
