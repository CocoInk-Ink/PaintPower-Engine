<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PaintPower_VM.VMPanel.VmPanel" xmlns:vm="clr-namespace:PaintPower_VM.VMPanel">
	<Grid>
		<Grid.Background>
			<ImageBrush Source="avares://Assets/Resources/Images/UI/Background/Background Dark.png" Stretch="None" TileMode="Tile" DestinationRect="0,0,10,10" />
		</Grid.Background>
		<Rectangle Fill="#80000000" />
		<Border Padding="10">
			<StackPanel Background="White">
				<TextBlock x:Name="VMPanelText" Text="VM Panel" FontSize="20" Foreground="Black" Margin="0 0 0 10" />
				<vm:StageAreaPart x:Name="StageArea"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>