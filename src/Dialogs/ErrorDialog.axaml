<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaintPower.Dialogs.ErrorDialog"
        Width="400"
        Height="180"
        Title="Error"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        xmlns:local="clr-namespace:PaintPower">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="16" />

        <Button Grid.Row="1"
                Content="OK"
                HorizontalAlignment="Right"
                Width="80"
                Margin="0,16,0,0"
                Click="OnOk" />
    </Grid>
</Window>
