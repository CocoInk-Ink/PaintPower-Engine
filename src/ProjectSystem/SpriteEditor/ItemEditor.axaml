<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:file="clr-namespace:PaintPower.FileExplorer"
             xmlns:edit="clr-namespace:PaintPower.FileEditors"
             x:Class="PaintPower.ProjectSystem.SpriteEditor.ItemEditor">

    <Grid ColumnDefinitions="250,5,*">

        <!-- Explorer -->
        <file:ExplorerView x:Name="Explorer" />

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      Background="#303030"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <!-- File Editor Host -->
        <ContentControl Grid.Column="2"
                        x:Name="EditorHost" />

    </Grid>
</UserControl>
