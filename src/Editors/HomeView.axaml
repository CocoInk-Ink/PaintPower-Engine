<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaintPower.Editors.HomeView">

    <Grid Background="{DynamicResource MainBackground}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Width="300">

            <TextBlock Text="Welcome to the PaintPower Engine!"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource HeaderForeground}" />

            <Button Content="New Project"
                    Click="OnNewProject"
                    Classes="accent" />

            <Button Content="Open Project"
                    Click="OnOpenProject" />

            <Button Content="Open Folder"
                    Click="OnOpenFolder" />

            <Button Content="New File"
                    Click="OnNewFile" />

            <Button Content="Open File"
                    Click="OnOpenFile" />
        </StackPanel>
    </Grid>

</UserControl>
