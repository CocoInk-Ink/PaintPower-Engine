1 Lexical Elements
Identifiers
Code
Identifier <- Letter (Letter | Digit | '_' | '-')*
Letter     <- A..Z | a..z
Digit      <- 0..9
Literals
Code
StringLiteral <- '"' (any char except '"' or escaped) '"'
IntegerLiteral <- Digit+
FloatLiteral <- Digit+ '.' Digit+
BoolLiteral <- 'true' | 'false'
HexLiteral <- '0x' HexDigit+
HexDigit <- Digit | A..F | a..f
2 File Structure
A KiteScript file is made of sections.
Sections do not nest inside each other.

Code
File <- Section*
Section <- ScriptSection
         | GuiSection
         | KxmlSection
         | DataSection
         | DisplaySection
Script section
Code
ScriptSection <- '[#script]' Statement*
Only script sections may contain:

[#lang ...]

[#quirk ...]

GUI section
Code
GuiSection <- '[#gui]' GuiContent*
XKML section
Code
KxmlSection <- '[#kxml]' KxmlContent*
Data section
Code
DataSection <- '[#data]' DataContent*
Display (HTML) section
Code
DisplaySection <- '[#diplay : #html]' HtmlContent '[/#diplay]'
3 Comments
Code
Comment <- '@!!' textUntilEndOfLine
         | '@#!' textUntilEndOfLine
Comments may appear anywhere.

4 General Tag Structure
All tags follow this pattern:

Code
Tag <- '[#' TagName TagModifiers? ']' TagArguments? TagBody?
TagName <- Identifier
TagModifiers <- (':' Identifier)* | AttributeList
AttributeList <- Attribute+
Attribute <- Identifier StringLiteral?
TagArguments <- '(' ArgumentList? ')'
ArgumentList <- Expression (',' Expression)*
TagBody <- Block | InlineContent
5 Script Grammar
Statements
Code
Statement <- DefineVarStmt
           | SetStmt
           | CallStmt
           | IfStmt
           | ForeachStmt
           | Block
           | HandlerStmt
           | ClassDecl
           | FuncDecl
           | ExportStmt
           | LangTag
           | QuirkTag
           | Comment
Language mode
Code
LangTag <- '[#lang' Identifier ']'
Quirk mode
Code
QuirkTag <- '[#quirk' Identifier ']'
6 Variables
Define variable
Code
DefineVarStmt <- '[#define var' VarName VarAlias? ']' '(' Expression? ')' ';'?
VarName <- Identifier | StringLiteral | HexLiteral
VarAlias <- Identifier?
Set variable
Code
SetStmt <- '[#set' VarName ']' '(' Expression ')' ';'?
Get variable (expression)
Code
GetExpr <- '[#get' VarName ']'
7 Calls
System or function call
Code
CallStmt <- '[#call' CallTarget ']' '(' ArgumentList? ')' ';'?
CallTarget <- Identifier | HexLiteral | QualifiedName
QualifiedName <- Identifier ('.' Identifier)*
8 Control Flow
If / Else If / Else
Code
IfStmt <- '[#if' Expression ']' Block (ElseIfStmt)* (ElseStmt)?
ElseIfStmt <- '[#else if' Expression ']' Block
ElseStmt <- '[#else]' Block
Block
Code
Block <- '[#block]' Statement* '[/#block]'
Foreach
Code
ForeachStmt <- '[#foreach' Identifier 'in' Expression ']' (CallStmt | Block)
9 Handlers (Events)
Code
HandlerStmt <- '[#handler' HandlerName HandlerParams? ']' Block
HandlerName <- Identifier
HandlerParams <- ':' Identifier (',' Identifier)*
Examples:

[#handler Start]

[#handler receive:message1]

[#handler KeyPress:W,UpArrow]

10 Functions
Code
FuncDecl <- '[#define func' Identifier TypeParams? ']' '(' ParamList? ')' ':' Type? Block
TypeParams <- '<' Identifier (',' Identifier)* '>'
ParamList <- Param (',' Param)*
Param <- Identifier ':' Type
11 Classes and OOP
Class declaration
Code
ClassDecl <- '[#define class' ClassName ClassExtends? ClassImplements? ']' ClassBody
ClassName <- Identifier
ClassExtends <- 'extends' Identifier
ClassImplements <- 'implements' Identifier (',' Identifier)*
ClassBody <- '[#block]' ClassMember* '[/#block]'
Class members
Code
ClassMember <- FieldDecl
             | PropertyDecl
             | MethodDecl
             | CtorDecl
             | StaticDecl
             | Comment
Field
Code
FieldDecl <- '[#field' AccessModifier? Identifier ']' ':' Type ';'?
AccessModifier <- 'public' | 'private' | 'protected' | 'internal'
Property
Code
PropertyDecl <- '[#property' AccessModifier? Identifier ']' ':' Type '{' PropertyAccessor* '}'
PropertyAccessor <- 'get;' | 'set;'
Constructor
Code
CtorDecl <- '[#ctor]' '(' ParamList? ')' Block
Method
Code
MethodDecl <- '[#method' AccessModifier? Identifier ']' '(' ParamList? ')' ':' Type? Block
12 Types
Code
Type <- Identifier TypeArgs?
TypeArgs <- '<' Type (',' Type)* '>'
Primitive types:

Int

Float

Bool

Char

String

Void

Special types:

Any

Nullable<T>

13 Generic Variables
Code
GenericVarDecl <- '[#define var' VarName ']' TypeParamList? '(' Expression? ')' ';'?
TypeParamList <- '<' Identifier (',' Identifier)* '>'
Example:

Code
[#define var box]<T>();
14 GUI / HTML Grammar
Display section
Code
DisplaySection <- '[#diplay : #html]' HtmlContent '[/#diplay]'
HTML elements
Code
HtmlContent <- HtmlElement*
HtmlElement <- HtmlTag
HtmlTag <- '[#' Identifier HtmlAttributes? ']' HtmlContent? '[/#' Identifier ']'
HtmlAttributes <- Attribute+
Examples:

Code
[#button id "runButton"]Run[/#button]
[#textarea id "codeArea" rows "20" cols "80"][/#textarea]
15 XKML Grammar
XKML section
Code
KxmlSection <- '[#kxml]' KxmlContent*
XKML content
Code
KxmlContent <- DataTag | Comment | TextNode
Data tag
Code
DataTag <- '[#data]' DataBody '[/#data]'
DataBody <- DataElement*
Data elements
Code
DataElement <- TableTag
             | PatternTag
             | RowTag
             | CellTag
Table
Code
TableTag <- '[#table' 'id' StringLiteral ']' TableBody '[/#table]'
TableBody <- DataElement*
Pattern
Code
PatternTag <- '[#pattern' 'id' StringLiteral ']' PatternBody '[/#pattern]'
PatternBody <- CellTag*
Row
Code
RowTag <- '[#row' 'id' StringLiteral ']' RowBody '[/#row]'
RowBody <- CellTag*
Cell
Code
CellTag <- '[#cell]' CellContent '[/#cell]'
CellContent <- Expression | StringLiteral | IntegerLiteral | FloatLiteral