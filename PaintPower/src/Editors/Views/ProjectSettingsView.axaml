<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:local="using:PaintPower.Editors"
             xmlns:selection="using:Avalonia.Controls.Selection"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaintPower.Editors.Views.ProjectSettingsView">

    <Grid>
        <StackPanel x:CompileBindings="False">
            <TextBlock Text="Project Settings" FontSize="20" />
            <Separator />
            <TextBlock Text="General" FontSize="16" />
            <TextBlock Text="Project Name" />
            <TextBox Text="{Binding ProjectName, Mode=TwoWay}" />
            <TextBlock Text="Project Description" />
            <TextBox Text="{Binding Description, Mode=TwoWay}" />
            <TextBlock Text="Project Version" />
            <TextBox Text="{Binding ProjectVersion, Mode=TwoWay}" />
            <TextBlock Text="Project Author" />
            <TextBox Text="{Binding Author, Mode=TwoWay}" />
            <Separator />
            <TextBlock Text="Advanced" FontSize="16" />
            <TextBlock Text="Stage Size" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Width" />
                <TextBox Text="{Binding StageWidth, Mode=TwoWay}" />
                <TextBlock Text="Height" />
                <TextBox Text="{Binding StageHeight, Mode=TwoWay}" />
                <Button Content="Reset" Click="ResetStageSize" />
            </StackPanel>
            <Separator />
            <TextBlock Text="PaintScript" FontSize="16" />
            <TextBlock Text="PaintScript Version" />
            <ComboBox SelectedIndex="0" Text="{Binding PaintScriptVersion, Mode=TwoWay}">
                <ComboBoxItem Content="Version 0.1" />
            </ComboBox>
        </StackPanel>
    </Grid>

</UserControl>