<!-- AnimationEditor.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaintPower.FileEditors.AnimationEditor"
             x:Name="AnimationEditor1"
             xmlns:conv="clr-namespace:PaintPower.Tools.Converters">

    <UserControl.Resources>
        <conv:FrameSelectedToColorConverter x:Key="FrameColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          ColumnDefinitions="3*,Auto,2*">

        <!-- Top bar -->
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Margin="4"
                    Spacing="8">

            <TextBlock Text="Animation Editor"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="PlayButton" Content="Play" Margin="8,0,0,0"/>
            <Button x:Name="StopButton" Content="Stop"/>
            <NumericUpDown x:Name="FpsBox" Width="60" Minimum="1" Maximum="60" Value="12"/>

            <Button Content="Add Layer" Click="OnAddLayer" Margin="16,0,0,0"/>
            <Button Content="Remove Layer" Click="OnRemoveLayer"/>
            <Button Content="Frames" Click="OnToggleDrawer"/>
        </StackPanel>

        <!-- Canvas -->
        <Border x:Name="CanvasArea"
                Grid.Row="1"
                Grid.Column="0"
                Margin="4"
                Background="#202020"
                BorderBrush="#404040"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="AnimationCanvas"
                    Background="#ECECEC"
                    PointerPressed="OnCanvasPointerPressed"
                    PointerMoved="OnCanvasPointerMoved"
                    PointerReleased="OnCanvasPointerReleased"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    x:CompileBindings="False"
                    MinWidth="50"
                    MinHeight="50">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </Border>

        <!-- Vertical splitter -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#505050"
                      Width="4"/>

        <!-- Properties panel -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Margin="4"
                Background="#252525"
                BorderBrush="#404040"
                BorderThickness="1">

            <StackPanel Margin="8" Spacing="6">

                <TextBlock Text="Canvas Size" Foreground="White" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="W:" Foreground="White"/>
                    <NumericUpDown Minimum="50" Maximum="1920"
                                   x:CompileBindings="False"
                                   Value="{Binding CanvasWidth}" Width="80"/>

                    <TextBlock Text="H:" Foreground="White" Margin="8,0,0,0"/>
                    <NumericUpDown Minimum="50" Maximum="1080"
                                   x:CompileBindings="False"
                                   Value="{Binding CanvasHeight}" Width="80"/>

                    <Button Content="Fit Canvas" Click="OnFitCanvas"/>
                </StackPanel>


                <TextBlock Text="Layers"
                           FontWeight="Bold"
                           Foreground="White"/>

                <!-- Layers list -->
                <ListBox x:CompileBindings="False"
                         ItemsSource="{Binding Layers.Layers}"
                         SelectedItem="{Binding SelectedLayer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding Visible}" Content="{Binding Name}"/>
                                <CheckBox IsChecked="{Binding Locked}" Content="Lock"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Selected Symbol:" Foreground="White" Margin="0,8,0,0"/>
                <ComboBox/>

                <TextBlock Text="Position" Foreground="White" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="X:" Foreground="White"/>
                    <NumericUpDown Width="60"/>
                    <TextBlock Text="Y:" Foreground="White" Margin="8,0,0,0"/>
                    <NumericUpDown Width="60"/>
                </StackPanel>

                <TextBlock Text="Opacity" Foreground="White" Margin="0,8,0,0"/>
                <Slider Minimum="0" Maximum="1" Value="1"/>

                <TextBlock Text="Zoom" Foreground="White" Margin="0,8,0,0"/>
                <Slider Minimum="0.1" Maximum="4.0" x:CompileBindings="False" Value="{Binding ZoomLevel}" Width="150"/>

                <TextBlock Text="Tools:" />
                <StackPanel></StackPanel>

                <TextBlock Text="Brush Sizes:" />
                <StackPanel>
                    <Image Width="15" Height="15" x:Name="VerySmallBrushButton" />
                    <Image Width="15" Height="15" x:Name="SmallBrushButton" />
                    <Image Width="15" Height="15" x:Name="MediumBrushButton" />
                    <Image Width="15" Height="15" x:Name="NormalBrushButton" />
                    <Image Width="15" Height="15" x:Name="BigBrushButton" />
                    <Image Width="15" Height="15" x:Name="VeryBigBrushButton" />
                    <Image Width="15" Height="15" x:Name="HugeBrushButton" />
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Horizontal splitter -
        <GridSplitter Grid.Row="2"
        Grid.ColumnSpan="3"
        ResizeDirection="Rows"
        Background="#505050"
        Height="4"/>-->

        <!-- Drawer: Frame previews -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                Background="#202020"
                BorderBrush="#404040"
                BorderThickness="1"
                x:Name="FrameDrawer"
                BoxShadow="0 0 12 #00000080"
                Height="32"> <!-- starts collapsed -->

                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Height"
                                          Duration="0:0:0.25"
                                          Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>

            <StackPanel Margin="8" Spacing="4">
                <Border Background="#202020"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        PointerPressed="OnToggleDrawer">
                    <TextBlock Text="Frames"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="4"/>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Disabled">

                    <ItemsControl x:CompileBindings="False"
                                  ItemsSource="{Binding SelectedLayer.Frames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Border Width="120"
                                        Height="80"
                                        Margin="4"
                                        BorderBrush="#707070"
                                        BorderThickness="1"
                                        Background="{Binding #AnimationEditor1.SelectedFrame,
                                        Converter={StaticResource FrameColorConverter},
                                        ConverterParameter={Binding}}">

                                    <Button Click="OnFrameClicked"
                                            Tag="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0">

                                        <StackPanel>

                                            <!-- Thumbnail preview -->
                                            <Border Background="White"
                                                    BorderBrush="#404040"
                                                    BorderThickness="1"
                                                    Height="60">
                                                <TextBlock Text="[Thumbnail]"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="Black"/>
                                            </Border>

                                            <!-- Frame number -->
                                            <TextBlock Text="{Binding}"
                                                       Foreground="White"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,4,4,0"/>
                                        </StackPanel>

                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
