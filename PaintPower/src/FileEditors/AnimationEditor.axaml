<!-- AnimationEditor.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="PaintPower.FileEditors.AnimationEditor"
			 xmlns:conv="clr-namespace:PaintPower.Tools.Converters">

	<UserControl.Resources>
		<conv:FrameSelectedToColorConverter x:Key="FrameColorConverter"/>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto,*,Auto"
		  ColumnDefinitions="3*,2*">

		<!-- Top bar: play, fps, add/remove frame -->
		<StackPanel Grid.Row="0"
					Grid.ColumnSpan="2"
					Orientation="Horizontal"
					Margin="4"
					Spacing="8">
			<TextBlock Text="Animation Editor"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button x:Name="PlayButton" Content="Play" Margin="8,0,0,0"/>
			<Button x:Name="StopButton" Content="Stop"/>
			<NumericUpDown x:Name="FpsBox" Width="60" Minimum="1" Maximum="60" Value="12"/>


			<Button Content="Add Frame" Margin="16,0,0,0"/>
			<Button Content="Remove Frame"/>
		</StackPanel>

		<!-- Canvas / preview area -->
		<Border x:Name="CanvasArea"
				Grid.Row="1"
				Grid.Column="0"
				Margin="4"
				Background="#202020"
				BorderBrush="#404040"
				BorderThickness="1">
			<Canvas x:Name="AnimationCanvas"/>
		</Border>

		<!-- Properties panel -->
		<Border Grid.Row="1"
				Grid.Column="1"
				Margin="4"
				Background="#252525"
				BorderBrush="#404040"
				BorderThickness="1">
			<StackPanel Margin="8" Spacing="6">
				<TextBlock Text="Properties"
						   FontWeight="Bold"
						   Foreground="White"/>

				<TextBlock Text="Selected Layer:" Foreground="White"/>
				<ComboBox/>

				<TextBlock Text="Selected Symbol:" Foreground="White" Margin="0,8,0,0"/>
				<ComboBox/>

				<TextBlock Text="Position" Foreground="White" Margin="0,8,0,0"/>
				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="X:" Foreground="White"/>
					<NumericUpDown Width="60"/>
					<TextBlock Text="Y:" Foreground="White" Margin="8,0,0,0"/>
					<NumericUpDown Width="60"/>
				</StackPanel>

				<TextBlock Text="Opacity" Foreground="White" Margin="0,8,0,0"/>
				<Slider Minimum="0" Maximum="1" Value="1"/>
			</StackPanel>
		</Border>

		<!-- Timeline -->
		<Border Grid.Row="2"
				Grid.ColumnSpan="2"
				Margin="4"
				Background="#202020"
				BorderBrush="#404040"
				BorderThickness="1">
			<StackPanel Margin="8" Spacing="4">
				<TextBlock Text="Timeline"
						   FontWeight="Bold"
						   Foreground="White"/>

				<!-- Placeholder: later replace with custom timeline control -->
				<ItemsControl>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Width="40" Height="40"
									Margin="2"
									Click="OnFrameClicked"
									Tag="{Binding}">
								<Border Background="#303030"
										BorderBrush="#606060"
										BorderThickness="1">
									<TextBlock Text="{Binding}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   Foreground="White"
											   FontSize="10"/>
								</Border>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>

				</ItemsControl>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
