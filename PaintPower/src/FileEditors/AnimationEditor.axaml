<!-- AnimationEditor.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaintPower.FileEditors.AnimationEditor"
             x:Name="AnimationEditor1"
             xmlns:conv="clr-namespace:PaintPower.Tools.Converters">

    <UserControl.Resources>
        <conv:FrameSelectedToColorConverter x:Key="FrameColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          ColumnDefinitions="3*,Auto,2*">

        <!-- Top bar -->
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Margin="4"
                    Spacing="8">

            <TextBlock Text="Animation Editor"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="PlayButton" Content="Play" Margin="8,0,0,0"/>
            <Button x:Name="StopButton" Content="Stop"/>
            <NumericUpDown x:Name="FpsBox" Width="60" Minimum="1" Maximum="60" Value="12"/>

            <Button Content="Add Layer" Click="OnAddLayer" Margin="16,0,0,0"/>
            <Button Content="Remove Layer" Click="OnRemoveLayer"/>
        </StackPanel>

        <!-- Canvas -->
        <Border x:Name="CanvasArea"
                Grid.Row="1"
                Grid.Column="0"
                Margin="4"
                Background="#202020"
                BorderBrush="#404040"
                BorderThickness="1">
            <Canvas x:Name="AnimationCanvas"/>
        </Border>

        <!-- Vertical splitter -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#505050"
                      Width="4"/>

        <!-- Properties panel -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Margin="4"
                Background="#252525"
                BorderBrush="#404040"
                BorderThickness="1">

            <StackPanel Margin="8" Spacing="6">

                <TextBlock Text="Layers"
                           FontWeight="Bold"
                           Foreground="White"/>

                <!-- Layers list -->
                <ListBox x:CompileBindings="False"
                         ItemsSource="{Binding Layers.Layers}"
                         SelectedItem="{Binding SelectedLayer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding Visible}" Content="{Binding Name}"/>
                                <CheckBox IsChecked="{Binding Locked}" Content="Lock"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Selected Symbol:" Foreground="White" Margin="0,8,0,0"/>
                <ComboBox/>

                <TextBlock Text="Position" Foreground="White" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="X:" Foreground="White"/>
                    <NumericUpDown Width="60"/>
                    <TextBlock Text="Y:" Foreground="White" Margin="8,0,0,0"/>
                    <NumericUpDown Width="60"/>
                </StackPanel>

                <TextBlock Text="Opacity" Foreground="White" Margin="0,8,0,0"/>
                <Slider Minimum="0" Maximum="1" Value="1"/>

            </StackPanel>
        </Border>

        <!-- Horizontal splitter -->
        <GridSplitter Grid.Row="2"
                      Grid.ColumnSpan="3"
                      ResizeDirection="Rows"
                      Background="#505050"
                      Height="4"/>

        <!-- Drawer: Frame previews -->
        <Expander Grid.Row="3"
                  Grid.ColumnSpan="3"
                  Margin="4"
                  Background="#202020"
                  BorderBrush="#404040"
                  BorderThickness="1"
                  ExpandDirection="Down"
                  IsExpanded="False">

            <Expander.Header>
                <TextBlock Text="Frames"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="4"/>
            </Expander.Header>

            <StackPanel Margin="8" Spacing="4">

                <!-- Frames for selected layer -->
                <ItemsControl x:CompileBindings="False" ItemsSource="{Binding SelectedLayer.Frames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="120"
                                    Height="80"
                                    Margin="4"
                                    BorderBrush="#606060"
                                    BorderThickness="1"
                                    Background="{Binding #AnimationEditor1.SelectedFrame,
                                        Converter={StaticResource FrameColorConverter},
                                        ConverterParameter={Binding}}">

                                <Button Click="OnFrameClicked"
                                        Tag="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0">

                                    <StackPanel>

                                        <!-- Thumbnail preview -->
                                        <Border Background="White"
                                                BorderBrush="#404040"
                                                BorderThickness="1"
                                                Height="60">
                                            <TextBlock Text="[Thumbnail]"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="Black"/>
                                        </Border>

                                        <!-- Frame number -->
                                        <TextBlock Text="{Binding}"
                                                   Foreground="White"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,4,0"/>
                                    </StackPanel>

                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Expander>

    </Grid>
</UserControl>
