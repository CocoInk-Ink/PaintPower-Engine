<UserControl
	x:Class="PaintPower.FileEditors.ScriptEditor"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
	xmlns:safeSyntax="clr-namespace:PaintPower.FileEditors.Tools.ScriptEditorTools.SafeSyntaxTools">

	<Grid Background="{DynamicResource MainBackground}" RowDefinitions="Auto,*,Auto">

		<StackPanel
			x:Name="ScriptControlsPanel"
			Grid.Row="0"
			Background="#008CFF"
			Orientation="Horizontal">
			<Button Click="SaveButtonClick">Save</Button>
			<Button>Check Syntax</Button>
		</StackPanel>

		<Border Grid.Row="1" Background="#70202020">
			<Grid x:Name="EditorLayout">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="300" />
					<ColumnDefinition Width="4" />
					<ColumnDefinition Width="240" MinWidth="0" />
				</Grid.ColumnDefinitions>

				<ae:TextEditor
					x:Name="Editor"
					Grid.Column="0"
					MinWidth="300"
					MinHeight="200"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					FontFamily="Consolas"
					FontSize="14"
					Foreground="White"
					HorizontalScrollBarVisibility="Auto"
					ShowLineNumbers="True"
					VerticalScrollBarVisibility="Auto" />

				<GridSplitter
					x:Name="SyntaxSplitter"
					Grid.Column="1"
					Background="#505050"
					ResizeDirection="Columns"
					ResizeBehavior="PreviousAndNext" />

				<safeSyntax:SafeSyntaxView
					x:Name="SafeSyntaxView"
					Grid.Column="2" />
			</Grid>
		</Border>

		<StackPanel
			x:Name="ScriptOptionsPanel"
			Grid.Row="2"
			Background="Gray"
			Orientation="Horizontal">
			<CheckBox
				x:Name="SafeSyntaxToggle"
				VerticalAlignment="Center"
				Content="Enable safe syntax"
				Checked="SafeSyntaxToggled"
				Unchecked="SafeSyntaxToggled" />
			<Button
				x:Name="ToggleSyntaxPanelButton"
				Margin="8,0,0,0"
				Content="Hide syntax panel"
				Click="ToggleSyntaxPanel" />
		</StackPanel>
	</Grid>

</UserControl>
