<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
			 x:Class="PaintPower.FileEditors.ScriptEditor">

		<Grid Background="{DynamicResource MainBackground}" RowDefinitions="Auto,*,Auto">

			<StackPanel Background="#008CFF" x:Name="ScriptControlsPanel" Orientation="Horizontal" Grid.Row="0">
				<Button Click="SaveButtonClick">Save</Button>
				<Button>Check Syntax</Button>
			</StackPanel>

			<Border Grid.Row="1" Background="#70202020">
				<ae:TextEditor x:Name="Editor"
							   Foreground="White"
							   ShowLineNumbers="True"
							   FontFamily="Consolas"
							   FontSize="14"
							   MinHeight="200"
							   MinWidth="300"
							   HorizontalScrollBarVisibility="Auto"
							   VerticalScrollBarVisibility="Auto"
							   HorizontalAlignment="Stretch"
							   VerticalAlignment="Stretch"
							   />
			</Border>

			<StackPanel Background="Gray" Grid.Row="2" x:Name="ScriptOptionsPanel">
				<TextBlock>Safe Syntax: disabled</TextBlock>
			</StackPanel>
		</Grid>

</UserControl>