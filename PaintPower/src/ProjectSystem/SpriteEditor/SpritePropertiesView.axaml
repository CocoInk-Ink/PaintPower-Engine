<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PaintPower.ProjectSystem.SpriteEditor.SpritePropertiesView">
    <Border Background="#252525" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock FontSize="20" Text="Sprite Properties" Foreground="White" Margin="8" />
                <!-- Sprite Name -->
                <TextBlock Text="Sprite Name" Foreground="White" FontSize="14" />
                <TextBox x:Name="NameBox" Background="#7c8083" Foreground="White" BorderBrush="#707070" />
                <Separator />
                <!-- Instance name (safe name) -->
                <TextBlock Text="Instance/Safe Name" Foreground="White" FontSize="14" />
                <TextBox x:Name="InstanceNameBox" Background="#404040" Foreground="White" BorderBrush="#7c8083" />
                <Separator />
                <Separator />
                <!-- Thumbnail Preview -->
                <TextBlock Text="Thumbnail" Foreground="White" FontSize="14" />
                <Border Background="#101010" BorderBrush="#404040" BorderThickness="1" Padding="4">
                    <Image x:Name="ThumbnailImage" Stretch="Uniform" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>