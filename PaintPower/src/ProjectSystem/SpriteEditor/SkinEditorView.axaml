<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PaintPower.ProjectSystem.SpriteEditor" xmlns:explorer="clr-namespace:PaintPower.FileExplorer" x:Class="PaintPower.ProjectSystem.SpriteEditor.SkinEditorView" x:DataType="local:SkinEditorView">
    <!-- Root grid so we can have an overlay canvas on top -->
    <Grid x:Name="Root" RowDefinitions="Auto,*" Background="#2b2b2b" PointerMoved="OnRootPointerMove" PointerReleased="OnRootPointerUp">
        <!-- TOP BAR -->
        <StackPanel Orientation="Horizontal" Background="#333" Margin="8" Spacing="8">
            <TextBlock Text="Skin Editor" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="-" Width="32" Click="OnZoomOut" />
            <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="3" Value="1" Width="160" VerticalAlignment="Center" />
            <Button Content="+" Width="32" Click="OnZoomIn" />
            <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1" ColumnDefinitions="260,5,*,5,260">
            <!-- LEFT SIDEBAR -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Background="#252525" Spacing="8" Margin="8">
                    <TextBlock Text="Elements" Foreground="White" FontSize="14" />
                    <ListBox x:Name="ElementsList" Height="200" Background="#1e1e1e" Foreground="White" SelectionChanged="OnElementSelected" />
                    <Separator />
                    <TextBlock Text="Properties" Foreground="White" FontSize="14" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" Foreground="White" />
                        <TextBox x:Name="NameBox" />
                        <TextBlock Text="X" Foreground="White" />
                        <TextBox x:Name="XBox" />
                        <TextBlock Text="Y" Foreground="White" />
                        <TextBox x:Name="YBox" />
                        <TextBlock Text="Rotation" Foreground="White" />
                        <TextBox x:Name="RotationBox" />
                        <TextBlock Text="Scale X" Foreground="White" />
                        <TextBox x:Name="ScaleXBox" />
                        <TextBlock Text="Scale Y" Foreground="White" />
                        <TextBox x:Name="ScaleYBox" />
                        <TextBlock Text="Z Index" Foreground="White" />
                        <TextBox x:Name="ZBox" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5" Background="#505050" />
            <!-- VIEWPORT -->
            <ScrollViewer x:Name="ViewportScrollViewer"
                          Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource MainBackgroundDark}">
                <Border x:Name="ViewportBorder"
                        BorderBrush="Gray"
                        BorderThickness="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CheckerboardBackground}"
                        ClipToBounds="True">
                    <Canvas x:Name="Viewport"
                            Width="{Binding Path=StageWidth, Mode=OneWay}"
                            Height="{Binding Path=StageHeight, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            PointerPressed="OnPointerDown"
                            PointerMoved="OnPointerMove"
                            PointerReleased="OnPointerUp"
                            PointerWheelChanged="OnZoom" />
                </Border>
            </ScrollViewer>
            <!-- SPLITTER -->
            <GridSplitter Grid.Column="3" Width="5" Background="#505050" />
            <!-- RIGHT SIDEBAR -->
            <Grid Grid.Column="4" Background="#252525" Margin="8" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Assets" Foreground="White" FontSize="14" Margin="0,0,0,8" />
                <explorer:ExplorerView x:Name="AssetExplorer" Grid.Row="1" />
            </Grid>
        </Grid>
        <!-- Overlay canvas for ghost drag preview -->
        <Canvas x:Name="Overlay" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
</UserControl>