<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="PaintPower.FirstLaunchWindow">
	<StackPanel>
		<TextBlock Text="Welcome to PaintPower!" />
		<TextBlock Text="Enjoy your experience!" />

		<TextBlock Text="Select your language" />
		<ComboBox>
			<ComboBoxItem Content="English" />
			<ComboBoxItem Content="Spanish" />
		</ComboBox>

		<TextBlock Text="Click 'Proceed' to continue" />
		<Button Content="Proceed" Click="Proceed_Button_Click" />

		<TextBlock Text="After clicking 'Proceed', the app will unpack it's things and prepare for use." />
	</StackPanel>
</Window>