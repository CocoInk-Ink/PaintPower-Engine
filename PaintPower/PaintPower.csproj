<!-- PaintPower -->

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>

    <RuntimeIdentifiers>
      win-x64;win-arm64;
      linux-x64;linux-arm64;
      osx-x64;osx-arm64
    </RuntimeIdentifiers>

    <Nullable>enable</Nullable>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>PaintPower-Engine</AssemblyName>

    <!-- FIX: prevent duplicate assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- Remove a specific XAML file -->
  <ItemGroup>
    <AvaloniaXaml Remove="src\Dialogs\PopupDialog.axaml" />
  </ItemGroup>

  <!-- Glue projects together. -->
  <ItemGroup>
    <ProjectReference Include="..\PaintPower-VM\PaintPower-VM.csproj" />
    <ProjectReference Include="..\Toolbox\Toolbox.csproj" />
    <ProjectReference Include="..\Assets\Assets.csproj" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />

    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
    <PackageReference Include="Classic.Avalonia.Theme.ColorPicker" Version="11.3.0.3" />
    <PackageReference Include="Classic.CommonControls.Avalonia" Version="11.3.0.3" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />


  </ItemGroup>

  <!-- Build timestamp -->
  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</BuildTimestamp>
    <DefineConstants>$(DefineConstants);BUILD_TIME=$(BuildTimestamp)</DefineConstants>
  </PropertyGroup>

  <!-- External reference -->
  <ItemGroup>
    <Reference Include="AvaloniaEdit">
      <HintPath>..\AvaloniaEdit\net6.0\AvaloniaEdit.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy assets to output WITHOUT the src folder -->
  <ItemGroup>
    <None Include="src\Assets\**" CopyToOutputDirectory="Always">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="src\Themes\**" CopyToOutputDirectory="Always">
      <Link>Themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>

<!-- End PaintPower -->